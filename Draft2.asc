TEXT -848 -1152 Left 2 !.tran 1 startup uic
TEXT -1120 -1248 Left 2 !.include IRF840.lib
TEXT -280 -1544 Left 2 !.param t_start=0.55 t_end=0.78\n \n.meas TRAN Setup_Time FIND time WHEN V(out)=0.001 RISE=1\n.meas TRAN Rise_Time TRIG V(out) VAL=2.4 RISE=1 TARG V(out) VAL=21.6 RISE=1\n.meas TRAN T_Drop FIND time WHEN V(out)=22.8 FALL=1 TD=0.8\n.meas TRAN Hold_Up PARAM T_Drop - 0.8\n \n.meas TRAN Max_Voltage_Anytime MAX V(out)\n.meas TRAN Overshoot_Volts PARAM Max_Voltage_Anytime - 24\n \n.meas TRAN V_Peak MAX V(out) FROM {t_start} TO {t_end}\n.meas TRAN V_Valley MIN V(out) FROM {t_start} TO {t_end}\n.meas TRAN Ripple PARAM V_Peak-V_Valley\n \n.meas TRAN V_rms RMS V(AC_LINE,AC_NEUTRAL) FROM {t_start} TO {t_end}\n.meas TRAN I_rms RMS I(B1) FROM {t_start} TO {t_end}\n.meas TRAN P_in AVG(V(AC_LINE,AC_NEUTRAL)*-I(B1)) FROM {t_start} TO {t_end}\n.meas TRAN P_out AVG(V(out)*I(R25)) FROM {t_start} TO {t_end}\n.meas TRAN PF PARAM P_in / (V_rms * I_rms)\n.meas TRAN Efficiency PARAM (P_out / P_in) * 100
